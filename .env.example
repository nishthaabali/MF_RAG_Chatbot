# Copy to .env and fill in. Never commit .env.

# Groq API key (server-side only). Without it, answers come from fixed fact templates.
GROQ_API_KEY=

# development | test | ci | production
APP_ENV=development

# Threads and messages (never bundled or published)
# DATABASE_URL=sqlite:///data/app.db

# Ingested corpus: sources, scheme facts, metrics (published in the daily data bundle)
# CORPUS_DATABASE_URL=sqlite:///data/corpus.db

# Optional: read-only GitHub token, needed only to pull data bundles from a private repository
# (config/settings.yaml: data_refresh.release_repo)
DATA_REFRESH_TOKEN=
